<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.incidencias</groupId>
    <artifactId>incidencia</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.4</version>
        </dependency>

        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>

        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.13.0</version>
        </dependency>

        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.13.0</version>
        </dependency>

        <dependency>
            <groupId>com.github.javakeyring</groupId>
            <artifactId>java-keyring</artifactId>
            <version>1.0.4</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- ====================================================================
             Login con Google (OAuth 2.0) sin contraseña de aplicación
             ==================================================================== -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.7.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-jetty</artifactId>
            <version>1.34.1</version>
        </dependency>

    </dependencies>

    <build>

        <plugins>
            <!-- ========================================================
                 0. Forzar plugin de compilación moderno
                 ======================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- ========================================================
                 1. Empaquetar dependencias (fase prepare-package)
                 ======================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>

                <configuration>

                    <archive>
                        <manifest>
                            <mainClass>com.incidencias.Main</mainClass>
                        </manifest>
                    </archive>

                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>

                </configuration>

                <executions>

                    <execution>
                        <id>make-assembly</id>
                        <phase>prepare-package</phase>

                        <goals>
                            <goal>single</goal>
                        </goals>

                    </execution>

                </executions>

            </plugin>

            <!-- ========================================================
                 2. ProGuard (genera el JAR público y el JAR _deb)
                 ======================================================== -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>

                <executions>
                    <!-- Compilación pública -->
                    <execution>
                        <id>proguard-public</id>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                        <configuration>
                            <injar>${project.build.finalName}-jar-with-dependencies.jar</injar>
                            <outjar>Incidencia_${app.version}.jar</outjar>
                        </configuration>
                    </execution>

                    <!-- Compilación debug (_deb) -->
                    <execution>
                        <id>proguard-debug</id>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                        <configuration>
                            <injar>${project.build.finalName}-deb-jar-with-dependencies.jar</injar>
                            <outjar>Incidencia_${app.version}_deb.jar</outjar>
                        </configuration>
                    </execution>
                </executions>

                <dependencies>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.9.1</version>
                        <scope>runtime</scope>
                    </dependency>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-core</artifactId>
                        <version>9.3.2</version>
                        <scope>runtime</scope>
                    </dependency>

                </dependencies>

                <configuration>

                    <inFilter>
                        !META-INF/versions/**,!module-info.class
                    </inFilter>

                    <obfuscate>true</obfuscate>

                    <!-- JDK que está usando Maven -->
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                        <lib>${java.home}/jmods/java.desktop.jmod</lib>
                        <lib>${java.home}/jmods/java.naming.jmod</lib>
                        <lib>${java.home}/jmods/java.logging.jmod</lib>
                    </libs>

                    <options>

                        <option>
                            -keep public class com.incidencias.Main {
                            public static void main(java.lang.String[]);
                            }
                        </option>

                        <option>-keepattributes *</option>

                        <!-- JNA -->
                        <option>-keep class com.sun.jna.** { *; }</option>

                        <option>
                            -keepclassmembers class * extends com.sun.jna.Structure {
                            *;
                            }
                        </option>

                        <!-- Ofuscar únicamente tu código -->
                        <option>-keep class !com.incidencias.** { *; }</option>
                        <option>-keep interface !com.incidencias.** { *; }</option>
                        <option>-keep enum !com.incidencias.** { *; }</option>

                        <option>-dontwarn **</option>
                        <option>-dontnote **</option>
                        <option>-ignorewarnings</option>

                        <option>-dontoptimize</option>
                        <option>-dontshrink</option>

                    </options>

                </configuration>

            </plugin>

            <!-- ========================================================
                 3. Crear EXE con Launch4j (empaqueta solo el JAR público)
                 ======================================================== -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.4.1</version>

                <executions>

                    <execution>

                        <id>l4j-clui</id>
                        <phase>package</phase>

                        <goals>
                            <goal>launch4j</goal>
                        </goals>

                        <configuration>

                            <headerType>gui</headerType>

                            <jar>
                                ${project.build.directory}/Incidencia_${app.version}.jar
                            </jar>

                            <outfile>
                                ${project.build.directory}/Incidencia_${app.version}.exe
                            </outfile>

                            <icon>icon.ico</icon>

                            <classPath>
                                <mainClass>com.incidencias.Main</mainClass>
                                <preCp>anything</preCp>
                            </classPath>

                            <jre>
                                <path>%JAVA_HOME%;%PATH%</path>
                                <minVersion>25.0</minVersion>

                                <opts>
                                    <opt>-Dfile.encoding=UTF-8</opt>
                                </opts>

                            </jre>

                            <versionInfo>

                                <fileVersion>
                                    ${app.version.numeric}.0.0
                                </fileVersion>

                                <txtFileVersion>
                                    ${app.version}
                                </txtFileVersion>

                                <fileDescription>
                                    Gestor de Incidencias OpenSource
                                </fileDescription>

                                <copyright>
                                    IES Teis
                                </copyright>

                                <productVersion>
                                    ${app.version.numeric}.0.0
                                </productVersion>

                                <txtProductVersion>
                                    ${app.version}
                                </txtProductVersion>

                                <productName>
                                    Gestor de Incidencias OpenSource
                                </productName>

                                <internalName>
                                    incidencias
                                </internalName>

                                <originalFilename>
                                    Incidencia_${app.version}.exe
                                </originalFilename>

                            </versionInfo>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

            <!-- ========================================================
                 4. Leer la versión (validate), preparar el JAR debug
                    (prepare-package) y limpiar intermedios (package)
                 ======================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>

                <executions>
                    <execution>
                        <id>leer-version</id>
                        <phase>validate</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>
                            <exportAntProperties>true</exportAntProperties>

                            <target>

                                <loadfile
                                    property="app.version"
                                    srcFile="${project.basedir}/src/main/java/com/incidencias/Version.java"
                                    encoding="UTF-8">

                                    <filterchain>
                                        <tokenfilter>

                                            <filetokenizer />

                                            <replaceregex
                                                pattern='(?s).*NUMERO\s*=\s*"([^"]+)".*'
                                                replace="\1" />

                                        </tokenfilter>
                                    </filterchain>

                                </loadfile>

                                
                                <loadfile
                                    property="app.version.numeric"
                                    srcFile="${project.basedir}/src/main/java/com/incidencias/Version.java"
                                    encoding="UTF-8">

                                    <filterchain>
                                        <tokenfilter>

                                            <filetokenizer />

                                            <replaceregex
                                                pattern='(?s).*NUMERO\s*=\s*"([0-9]+(?:\.[0-9]+)*)(?:-[^"]+)?".*'
                                                replace="\1" />

                                        </tokenfilter>
                                    </filterchain>

                                </loadfile>

                                <fail
                                    unless="app.version.numeric"
                                    message="ERROR: No se ha podido obtener la versión numérica desde Version.java" />

<fail
                                    unless="app.version"
                                    message="ERROR: No se ha podido obtener la versión desde Version.java" />

                                <echo
                                    message="Versión detectada desde Version.java: ${app.version}" />

                            </target>
                        </configuration>

                    </execution>

                    <execution>
                        <id>preparar-jar-debug</id>
                        <phase>prepare-package</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/debug-src/com/incidencias" />
                                <mkdir dir="${project.build.directory}/debug-classes" />

                                <copy
                                    file="${project.basedir}/src/main/java/com/incidencias/Version.java"
                                    tofile="${project.build.directory}/debug-src/com/incidencias/Version.java"
                                    overwrite="true"
                                    encoding="UTF-8">
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="return\s+false\s*;"
                                                replace="return true;" />
                                        </tokenfilter>
                                    </filterchain>
                                </copy>

                                <javac srcdir="${project.build.directory}/debug-src"
                                    destdir="${project.build.directory}/debug-classes"
                                    release="25"
                                    encoding="UTF-8"
                                    includeantruntime="false" />

                                <copy
                                    file="${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar"
                                    tofile="${project.build.directory}/${project.build.finalName}-deb-jar-with-dependencies.jar"
                                    overwrite="true" />

                                <jar
                                    destfile="${project.build.directory}/${project.build.finalName}-deb-jar-with-dependencies.jar"
                                    basedir="${project.build.directory}/debug-classes"
                                    update="true" />
                            </target>
                        </configuration>
                    </execution>

                    <execution>
                        <id>limpiar-jars-intermedios</id>
                        <phase>package</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>
                            <target>
                                <delete
                                    file="${project.build.directory}/${project.build.finalName}.jar"
                                    quiet="true" />
                                <delete
                                    file="${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar"
                                    quiet="true" />
                                <delete
                                    file="${project.build.directory}/${project.build.finalName}-deb-jar-with-dependencies.jar"
                                    quiet="true" />
                                <delete
                                    dir="${project.build.directory}/debug-src"
                                    quiet="true" />
                                <delete
                                    dir="${project.build.directory}/debug-classes"
                                    quiet="true" />
                            </target>
                        </configuration>
                    </execution>
                </executions>

            </plugin>

        </plugins>

    </build>

</project>
